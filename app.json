{
  "package": "tv.rootu.perfecttv",
  "appId": "99009990",
  "name": "Perfect TV",
  "version": "0.1.0",
  "registerName": "PerfectTVNative",
  "binary": "perfecttv-app",
  "envPrefix": "PTV",
  "symbolPrefix": "ptv_",
  "architecture": "mtk9655",
  "network": true,
  "sources": [
    "src/core/util.c",
    "src/core/lang.c",
    "src/core/clock.c",
    "src/core/prefs.c",
    "src/core/http.c",
    "src/core/unpack.c",
    "src/core/qr.c",
    "src/core/phone.c",
    "src/data/names.c",
    "src/data/m3u.c",
    "src/data/xmltv.c",
    "src/data/catchup.c",
    "src/data/epg.c",
    "src/data/repo.c",
    "src/data/loaders.c",
    "src/player/player.c",
    "src/ui/u.c",
    "src/ui/keys.c",
    "src/ui/layer.c",
    "src/ui/tv.c",
    "src/ui/info.c",
    "src/ui/guide.c",
    "src/ui/schedule.c",
    "src/ui/menu.c",
    "src/ui/popups.c",
    "src/ui/pin.c",
    "src/ui/settings.c",
    "src/ui/form.c",
    "src/ui/phone.c",
    "src/main.c"
  ],
  "shell": true,
  "fw": ["app", "gfx", "text", "json", "net", "widgets"],
  "imgDecoder": "stb",
  "vendorPlayers": ["player-hmc", "sw_player"],
  "fonts": [
    { "symbol": "regular", "file": "NotoSans-Regular.ttf" },
    { "symbol": "bold", "file": "NotoSans-Bold.ttf" },
    { "symbol": "ui", "file": "Onest-Regular.ttf" },
    { "symbol": "ui_semi", "file": "Onest-SemiBold.ttf" },
    { "symbol": "ui_bold", "file": "Onest-Bold.ttf" }
  ],
  "embedCa": true,
  "shipCa": true,
  "shared": ["freetype", "z", "avformat", "avcodec", "avutil", "swscale", "swresample"],
  "shipExtra": ["asound", "ssl", "crypto"],
  "icon": "assets/icon-400.png",
  "credits": "Perfect TV for VIDAA (GPL-3.0, https://github.com/perfect-tv). Built with FreeType (FreeType License), zlib (zlib License), OpenSSL (Apache-2.0), FFmpeg (LGPL-2.1+), stb_image (public domain), Noto Sans and Onest (SIL OFL)."
}
